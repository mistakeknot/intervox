set -e
printf '"'%s\\n' \""'$probe_output"
printf '"'vale_exit=%s\\n' \""'$probe_status"
test "$probe_status" = 1
printf '"'%s\\n' \""'$probe_output" | grep -q '"'GSV.ThroatClearing'
