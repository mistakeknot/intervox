The live check exposed an important wording issue: omitting `register:` does not disable stylometry; it selects the general `all.json` baseline. I corrected the documentation to say that plainly. The configuration task has no production-code behavior to TDD, so I’m using the plan’s executable checks plus a synthetic Vale probe and declared/undeclared path checks.
exec
/bin/zsh -lc "set -e
printf '%s\\n' '--- task verify ---'
test -s .voicepaths && grep -q \"voice-check.sh\" AGENTS.md && echo ok
printf '%s\\n' '--- declaration invariants ---'
"'! grep -q '"'"'^register:'"' .voicepaths
grep -qx 'style: GSV' .voicepaths
for glob in 'site/src/pages/**/*.astro' 'site/src/layouts/**/*.astro' 'README.md'; do grep -Fqx \""'$glob" .voicepaths; done
python3 /Users/sma/projects/Sylveste/interverse/intervox/engine/voicepaths.py match "$PWD" "$PWD/README.md" "$PWD/site/src/pages/index.astro" "$PWD/site/src/layouts/Layout.astro"
set +e
undeclared_output="$(bash /Users/sma/projects/Sylveste/interverse/intervox/scripts/voice-check.sh --gate --root . AGENTS.md 2>&1)"
undeclared_status=$?
set -e
printf '"'%s\\n' \""'$undeclared_output"
printf '"'undeclared_exit=%s\\n' \""'$undeclared_status"
test "$undeclared_status" = 0
printf '"'%s\\n' '--- Vale rules probe (expected findings) ---'
set +e
probe_output=\""'$(vale --config=.vale.ini --output=line /private/tmp/jawnomicon-voice-probe.last.md 2>&1)"
