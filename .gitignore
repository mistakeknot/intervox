__pycache__/
*.pyc
.DS_Store

# Beads: the embedded Dolt store is live database state, not source.
# bd's own .beads/.gitignore names "dolt/", but the runtime directory is
# "embeddeddolt/", so that rule never matched. intervoice carries this line;
# intervox did not, so 82 files of binary database were tracked.
.beads/embeddeddolt/

# Agent working state: local tooling, not product. The pre-commit hook is the
# exception: it runs the secret scan, so it stays tracked.
.beads/*
!.beads/hooks/
.beads/hooks/*
!.beads/hooks/pre-commit
.clavain/
.claude/settings.json
.claude/settings.local.json
.git-autosync
